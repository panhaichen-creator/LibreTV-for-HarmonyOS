/**
 * 页面级视觉主题（方案 A「通透玻璃」的底）
 *
 * ── 为什么这里从「三段渐变」改成了纯色 ─────────────────────────────────
 * 原来的实现是 顶部淡蓝 → 中段回到底色 → 底部淡青 的三段竖向渐变。
 * 在手机上还能糊过去，到平板上就露馅了，原因有两个：
 *
 * 1. **8bit 量化必然产生横向色带。**
 *    深色主题原来的两个端点差 21 级（#191922 → #2E2723），
 *    在 2456px 高的屏幕上就是 21 条带子、每条 ~117px 宽 —— 一眼就看得出「分层」。
 *    渐变是矢量绘制、本身没有分辨率问题，加更多色标也不会让色带变细
 *    （输出仍然只有 256 级），唯一的解法是**把端点差压到 1~3 级**，
 *    压到这种程度就等于纯色了。
 *
 * 2. **中段比两端更暗，是「折返」而不是「单向」。**
 *    深色主题里 color_bg(#101014) 比 color_bg_top(#191922) 还暗，
 *    所以纵向剖面是 亮 → 暗 → 亮，中间出现两条方向反转的过渡带，
 *    看起来就是「上下两块底色拼在一起」。
 *
 * 结论：全屏底色用纯色，不再画渐变。层次感交给内容卡片和玻璃条
 * （它们是小面积 + 自带模糊，不会出现色带）。
 *
 * 保留函数名是为了让 8 个页面的调用点不用改：返回的仍是 LinearGradientOptions，
 * 只是首尾同色，等价于纯色填充。
 */

export function pageBgGradient(): LinearGradientOptions {
  const colors: Array<[ResourceColor, number]> = [
    [$r('app.color.color_page_bg'), 0],
    [$r('app.color.color_page_bg'), 1]
  ];
  return {
    direction: GradientDirection.Bottom,
    colors: colors
  };
}
