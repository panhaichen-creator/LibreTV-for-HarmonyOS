{
  "module": {
    "name": "entry",
    "type": "entry",
    "deliveryWithInstall": true,
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1",
      "tv"
    ],
    "pages": "$profile:main_pages",
    // 应用级开启 HarmonyOS 7 沉浸光感：弹窗、菜单等系统组件默认带上材质与光感反馈。
    // entry 类型 module 才生效；组件级 systemMaterial 优先级更高。
    "metadata": [
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:permission_internet_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:permission_network_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:permission_camera_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:permission_background_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        // 大屏/超级桌面适配：显式声明横屏与全屏能力，系统才会把应用当作
        // 「可按大屏渲染」的媒体类应用分配窗口（否则走平行视界的手机比例通道）
        "orientation": "auto_rotation",
        "backgroundModes": ["audioPlayback"],
        "supportWindowMode": ["fullscreen", "split"],
        "minWindowWidth": 320,
        "minWindowHeight": 320,
        "maxWindowWidth": 3840,
        "maxWindowHeight": 2160,
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          // 影片分享链接的入口：对方点开 libretv://play?... 时系统按 viewData 拉起本应用。
          // scheme 必须与 ShareLink.SCHEME 完全一致；host 用 play。
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "libretv",
                "host": "play"
              }
            ]
          }
        ]
      }
    ]
  }
}
