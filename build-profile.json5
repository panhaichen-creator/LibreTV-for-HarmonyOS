{
  "app": {
    /*
     * 签名配置说明（开源版留空，务必不要提交自己的证书与密码）
     *
     * 本仓库不内置任何签名证书。命令行构建产出的是未签名 HAP，无法直接装机。
     * 请在 DevEco Studio 中一次性生成签名，之后构建配置会自动回填：
     *   File → Project Structure → Project → Signing Configs
     *   → 勾选 "Automatically generate signature" → 登录华为账号 → OK
     *
     * 回填后形如（不要在 PR 里提交这一段）：
     *   "signingConfigs": [{
     *     "name": "default",
     *     "type": "HarmonyOS",
     *     "material": {
     *       "certpath":      "<你的绝对路径>.cer",
     *       "keyAlias":      "debugKey",
     *       "keyPassword":   "<加密后的口令>",
     *       "profile":       "<你的绝对路径>.p7b",
     *       "signAlg":       "SHA256withECDSA",
     *       "storeFile":     "<你的绝对路径>.p12",
     *       "storePassword": "<加密后的口令>"
     *     }
     *   }]
     */
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "C:\\Users\\zdc66\\.ohos\\config\\default_LibreTV-for-HarmonyOS-main_cECy4a076FsyFGjeQh4cvDJPM7g9F60irDvIpG71I88=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "0000001B777D55226C9F96BFB8177A070B5D6B5C8937B11F4FDB92941648755CE93AEEE308B010A06C4492",
          "profile": "C:\\Users\\zdc66\\.ohos\\config\\default_LibreTV-for-HarmonyOS-main_cECy4a076FsyFGjeQh4cvDJPM7g9F60irDvIpG71I88=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "C:\\Users\\zdc66\\.ohos\\config\\default_LibreTV-for-HarmonyOS-main_cECy4a076FsyFGjeQh4cvDJPM7g9F60irDvIpG71I88=.p12",
          "storePassword": "0000001B937C91C5CBFCD96F31BE64E4DFF730B11BA5D3CE18E3D2DF45DFC13D8D3EB6CEF1FC1A342AA5B0"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compileSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
